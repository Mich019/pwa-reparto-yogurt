# Copia este archivo a .env y ajusta los valores (nunca subas .env al repositorio).
# En Vercel, las mismas variables van en Settings → Environment Variables.

# --- API ---
DATABASE_URL=postgres://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/reparto_yogurt
# true si la base pide SSL (Supabase, Neon...).
DB_SSL=false
# Al menos 32 caracteres aleatorios:  openssl rand -hex 32
JWT_SECRET=
PORT=3000
# Orígenes que pueden llamar a la API, separados por comas.
CORS_ORIGINS=http://localhost:5173,https://mich019.github.io
# true si la API está detrás de un proxy (Nginx, Render, Railway...), para leer la IP real. En Vercel ya lo es.
TRUST_PROXY=false
# Qué es «hoy» para el negocio.
ZONA_HORARIA=America/Mexico_City
# Recuperación de contraseña por correo (RF-002). Sin clave, fuera de producción el código sale en la consola.
RESEND_API_KEY=
MAIL_FROM=Reparto Yogurt <onboarding@resend.dev>
# Notificaciones push (RF-054): npm run push:claves genera el par. Van las tres o ninguna.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- App ---
# Dirección de la API. Vacía = /api (en local, Vite la pasa a la API; en Vercel es el mismo dominio).
VITE_API_URL=
# true = la app trabaja sólo en el teléfono, sin cuentas ni servidor.
VITE_OFFLINE_SOLO=false
