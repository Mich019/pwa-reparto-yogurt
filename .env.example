# Copia este archivo a .env y ajusta los valores (nunca subas .env al repositorio).
# En Vercel, las mismas variables van en Settings → Environment Variables.
# Revisa que todo esté bien (sin cambiar nada en la base) con:  npm run db:probar

# --- API ---
# Base PostgreSQL. En Railway: servicio Postgres → Variables → copia DATABASE_PUBLIC_URL si la API corre fuera de Railway
# (Vercel, tu computadora), o DATABASE_URL (red privada, *.railway.internal) si corre dentro de Railway. Se pega tal cual.
# Ejemplo Railway: postgresql://postgres:CLAVE@xxxx.proxy.rlwy.net:12345/railway
DATABASE_URL=postgres://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/reparto_yogurt
# Cifrado (SSL). Vacío = automático: se cifra con la dirección pública de Railway (*.rlwy.net) o si trae ?sslmode=require.
# true / false lo fuerzan; verify-full además exige un certificado de una autoridad pública con el nombre del servidor.
# Railway usa un certificado propio: se cifra sin verificarlo, salvo que pongas DB_SSL_CA (docs/produccion-railway.md).
DB_SSL=
# Opcional: certificado de la base (PEM, o en base64) para además verificar que es ella.
DB_SSL_CA=
# Opcional: conexiones por instancia (por defecto 3 en Vercel, 10 en un servidor normal).
DB_POOL_MAX=
# Al menos 32 caracteres aleatorios:  openssl rand -hex 32
JWT_SECRET=
# Pepper de las contraseñas: otra clave de al menos 32 caracteres, distinta de JWT_SECRET (openssl rand -hex 32).
# Se mezcla con cada contraseña antes de Argon2id y no vive en la base: quien robe la base no puede probar
# contraseñas sin ella. Sin esta variable la API no arranca. Guárdala bien: si se pierde, ninguna contraseña sirve
# y hay que restablecerlas (por correo o desde Equipo).
AUTH_PEPPER_SECRET=
# Sólo para cambiar el pepper: pon aquí el anterior y el nuevo en AUTH_PEPPER_SECRET. Cada quien queda con el
# nuevo al entrar; cuando todos hayan entrado, se borra.
AUTH_PEPPER_ANTERIOR=
PORT=3000
# Orígenes que pueden llamar a la API, separados por comas.
CORS_ORIGINS=http://localhost:5173,https://mich019.github.io
# Proxies delante de la API (Nginx, Render, Railway...): true = uno, o el número exacto. Así se lee la IP real para
# los límites de intentos; con un número de más, cualquiera podría fingir otra IP. En Vercel no hace falta.
TRUST_PROXY=false
# Qué es «hoy» para el negocio.
ZONA_HORARIA=America/Mexico_City
# Recuperación de contraseña por correo (RF-002). Sin clave, fuera de producción el código sale en la consola.
RESEND_API_KEY=
MAIL_FROM=Delisy <onboarding@resend.dev>
# Dirección de la app para los enlaces de los correos (invitaciones). Vacío: el primer CORS_ORIGINS o el dominio de Vercel.
APP_URL=
# Cobro con Mercado Pago (suscripción mensual). Sin token y precio nadie puede suscribirse, pero la app funciona.
# El aviso de pagos (Webhooks, evento «Planes y suscripciones») va a https://<tu-dominio>/api/mercadopago/webhook
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PRECIO_MENSUAL=
# Días de prueba gratis de cada empresa nueva (14 si no se pone).
PRUEBA_DIAS=
# Notificaciones push (RF-054): npm run push:claves genera el par. Van las tres o ninguna.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- App ---
# Dirección de la API. Vacía = /api (en local, Vite la pasa a la API; en Vercel es el mismo dominio).
VITE_API_URL=
# true = la app trabaja sólo en el teléfono, sin cuentas ni servidor.
VITE_OFFLINE_SOLO=false
