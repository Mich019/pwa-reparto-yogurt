{
  "name": "pwa-yogurt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite --host\" \"npm:dev:api\"",
    "dev:web": "vite --host",
    "dev:api": "tsx watch --env-file-if-exists=.env api/_lib/servidor.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck:api": "tsc --noEmit -p api",
    "test:api": "tsx --test api/_test/*.test.ts",
    "db:migrar": "tsx --env-file-if-exists=.env db/migrar.ts",
    "db:admin": "tsx --env-file-if-exists=.env db/crear-admin.ts",
    "db:plataforma": "tsx --env-file-if-exists=.env db/plataforma.ts",
    "db:probar": "tsx --env-file-if-exists=.env db/probar-conexion.ts",
    "push:claves": "tsx api/_lib/claves-push.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fastify": "^5.12.7",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.15.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
